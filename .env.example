# RUM vendor: sentry (default) | datadog. Read at build time; rebuild after changing.
NEXT_PUBLIC_RUM_TYPE=sentry

# Datadog RUM (application id and client token are public). Used when NEXT_PUBLIC_RUM_TYPE=datadog.
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DD_ENV=local

# Runtime (DSN is public, safe to share). Copy to .env.local.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-time source map upload. Put these in .env.sentry-build-plugin (gitignored),
# never in a committed file. Use an Organization Auth Token.
# SENTRY_ORG=
# SENTRY_PROJECT=sentry-ai-demo
# SENTRY_AUTH_TOKEN=
